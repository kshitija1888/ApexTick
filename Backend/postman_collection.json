{
  "info": {
    "name": "Smart Market Watchlist API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000" },
    { "key": "user_id", "value": "11111111-1111-1111-1111-111111111111" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{base_url}}/health" }
    },
    {
      "name": "GET watchlist - no auth header (expect 401)",
      "request": { "method": "GET", "url": "{{base_url}}/api/watchlist" }
    },
    {
      "name": "Heartbeat (first visit - previousVisit should be null)",
      "request": {
        "method": "POST",
        "header": [{ "key": "x-user-id", "value": "{{user_id}}" }],
        "url": "{{base_url}}/api/user/heartbeat"
      }
    },
    {
      "name": "Add RELIANCE.NS to watchlist",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{user_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticker\": \"RELIANCE.NS\"\n}"
        },
        "url": "{{base_url}}/api/watchlist"
      }
    },
    {
      "name": "Add same ticker again (expect 409 conflict)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{user_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticker\": \"RELIANCE.NS\"\n}"
        },
        "url": "{{base_url}}/api/watchlist"
      }
    },
    {
      "name": "Add unknown ticker (expect 404)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{user_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticker\": \"FAKECO.NS\"\n}"
        },
        "url": "{{base_url}}/api/watchlist"
      }
    },
    {
      "name": "Get watchlist (should show RELIANCE.NS with live price + change%)",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-user-id", "value": "{{user_id}}" }],
        "url": "{{base_url}}/api/watchlist"
      }
    },
    {
      "name": "Heartbeat again (previousVisit should now be the earlier timestamp)",
      "request": {
        "method": "POST",
        "header": [{ "key": "x-user-id", "value": "{{user_id}}" }],
        "url": "{{base_url}}/api/user/heartbeat"
      }
    },
    {
      "name": "Remove RELIANCE.NS from watchlist",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "x-user-id", "value": "{{user_id}}" }],
        "url": "{{base_url}}/api/watchlist/RELIANCE.NS"
      }
    },
    {
      "name": "Remove again (expect 404 - already gone)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "x-user-id", "value": "{{user_id}}" }],
        "url": "{{base_url}}/api/watchlist/RELIANCE.NS"
      }
    }
  ]
}